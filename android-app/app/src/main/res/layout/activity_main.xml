<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- App Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HA P2P Tunnel"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v0.1.0 Beta"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:background="@drawable/bg_badge"
                android:backgroundTint="#0F2847"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conexão direta P2P sem portas abertas ou CGNAT • Por Jho"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp" />

        <!-- HERO STATUS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header row with badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="STATUS DA CONEXÃO"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/badgeStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DESCONECTADO"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/badge_stopped_text"
                        android:background="@drawable/bg_badge"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />
                </LinearLayout>

                <!-- Status indicator and title -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/viewStatusDot"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/bg_dot"
                        android:backgroundTint="@color/status_red"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/tvStatusTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Túnel Parado"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main" />
                </LinearLayout>

                <!-- Subtitle / detail text -->
                <TextView
                    android:id="@+id/tvStatusSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Inicie o túnel para localizar o Home Assistant"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginStart="26dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp" />

                <!-- Connecting Progress Bar (Indeterminate) -->
                <ProgressBar
                    android:id="@+id/progressBarConnecting"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#223348"
                    android:layout_marginBottom="12dp" />

                <!-- Network info table -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:text="Proxy Local:"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvLocalAddr"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="http://127.0.0.1:8123"
                        android:fontFamily="monospace"
                        android:textSize="12sp"
                        android:textColor="@color/accent" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:text="Home Assistant:"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvConnectedHA"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Desconectado"
                        android:textSize="12sp"
                        android:textColor="@color/text_main" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ACTION BUTTON: OPEN HOME ASSISTANT -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenHA"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="ABRIR HOME ASSISTANT"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_launch"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/primary"
            android:layout_marginBottom="10dp" />

        <!-- ACTION BUTTON: TOGGLE TUNNEL -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleTunnel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="INICIAR TÚNEL P2P"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            android:textColor="@color/text_main"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            android:backgroundTint="@color/card_bg"
            android:layout_marginBottom="16dp" />

        <!-- CONFIGURATION CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONFIGURAÇÕES DO TÚNEL"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="14dp" />

                <!-- Scan QR Code Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanQr"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="ESCANEAR QR CODE DO ADD-ON"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_qr_code"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:cornerRadius="12dp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#1E3A8A"
                    android:layout_marginBottom="14dp" />

                <!-- Peer ID Input -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="PeerID do Add-on do Home Assistant"
                    android:textColorHint="@color/text_secondary"
                    app:boxStrokeColor="@color/primary"
                    app:hintTextColor="@color/accent"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPeerId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_main"
                        android:fontFamily="monospace"
                        android:textSize="13sp"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- PSK Secret Key Input -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Chave Secreta PSK (Opcional)"
                    android:textColorHint="@color/text_secondary"
                    app:boxStrokeColor="@color/primary"
                    app:hintTextColor="@color/accent"
                    app:helperText="Deixe vazio se não configurou PSK no Add-on"
                    app:helperTextTextColor="@color/text_secondary"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPsk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_main"
                        android:textSize="13sp"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Auto Start Switch -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchBoot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Iniciar junto com o celular (Boot)"
                    android:textColor="@color/text_main"
                    android:layout_marginTop="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- LIVE LOGS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="LOGS EM TEMPO REAL"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/btnCopyLogs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COPIAR"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent"
                        android:padding="6dp" />

                    <TextView
                        android:id="@+id/btnClearLogs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIMPAR"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:padding="6dp" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/logScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="#0A0F1D"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tvLogs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pronto para iniciar..."
                        android:fontFamily="monospace"
                        android:textSize="11sp"
                        android:textColor="#38BDF8"
                        android:lineSpacingExtra="3dp" />
                </ScrollView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
